    <string name="wifi_bssid_hint">Ponechte prázdné, aby pravidlo odpovídalo všem přístupovým bodům s tímto SSID.</string>
    <string name="wifi_rule_action_label">Akce pro tuto síť</string>
    <string name="wifi_rule_action_default">Použít výchozí nastavení DNS pro Wi-Fi</string>
    <string name="wifi_rule_invalid_or_duplicate">Zadejte platné SSID nebo BSSID a ověřte, že stejné pravidlo ještě neexistuje.</string>
