    <string name="wifi_ssid_permission_description">Android považuje názvy Wi-Fi (SSID), identifikátory přístupových bodů (BSSID) a výsledky okolních sítí za údaje související s polohou. K jejich čtení je nutné oprávnění k přesné poloze. Funkce nečte souřadnice polohy.</string>
    <string name="wifi_ssid_permission_docs_link">Dokumentace Androidu k oprávnění pro SSID</string>
    <string name="wifi_ssid_permission_grant">Povolit přístup</string>
    <string name="wifi_location_services_title">Zapnout služby určování polohy</string>
    <string name="wifi_location_services_description">Oprávnění je uděleno, ale Android zobrazí připojené SSID/BSSID a poslední výsledky Wi-Fi jen při zapnutých službách určování polohy.</string>
    <string name="wifi_location_services_open">Otevřít nastavení polohy</string>
    <string name="wifi_ssid_manual_entry_notice">Pravidlo můžete zadat ručně, automatické přiřazení však tento přístup stále potřebuje. Dokud není aktuální síť známá, privátní DNS se nezmění.</string>
    <string name="wifi_ssid_permission_denied">K rozpoznání sítí Wi-Fi je nutné oprávnění k přesné poloze. Dokud nebude přístup povolen, privátní DNS se nezmění.</string>
    <string name="wifi_location_services_disabled">Zapněte služby určování polohy Androidu, aby bylo možné zjistit název připojené sítě Wi-Fi. Dokud není identita sítě dostupná, privátní DNS se nezmění.</string>
    <string name="wifi_rules_require_background_detection">Pravidla Wi-Fi vyžadují detekci na pozadí. Vypněte je, než omezíte detekci pouze na dobu, kdy je tlačítko rychlého nastavení viditelné.</string>
    <string name="wifi_rules_enabled_background_detection">Detekce na pozadí byla zapnuta, protože ji pravidla Wi-Fi potřebují.</string>
    <string name="wifi_ssid_label">Název sítě (SSID)</string>
    <string name="wifi_network_current_title">Aktuálně připojeno</string>
    <string name="wifi_network_nearby_title">Sítě v okolí</string>
    <string name="wifi_network_history_title">Nedávno rozpoznané sítě</string>
    <string name="wifi_network_scanning">Načítají se poslední dostupné výsledky vyhledávání Wi-Fi z Androidu…</string>
    <string name="wifi_network_none_found">Nejsou dostupné žádné nedávné výsledky Wi-Fi. Aplikace nespouští nový sken; Android může poskytnout výsledky z mezipaměti.</string>
    <string name="wifi_network_refresh">Znovu načíst výsledky</string>
    <string name="wifi_hidden_network">Skrytá síť</string>
